---
import Layout from "../layouts/Layout.astro";
import CityHome from "../components/CityHome.astro";
import CityHint from "../components/CityHint.astro";
import { DEFAULT_CITY } from "../data/cities";
---

{
  /*
  Renders the default city. A stored choice is swapped in before first paint by
  the inline scripts; visitors without one get the CityHint banner offering the
  other cities.
*/
}
<Layout>
  <CityHint />
  <CityHome city={DEFAULT_CITY} />
</Layout>
