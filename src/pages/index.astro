---
import Layout from "../layouts/Layout.astro";
import CityHome from "../components/CityHome.astro";
import CityPicker from "../components/CityPicker.astro";
---

{
  /*
  Both are rendered; the gate CSS in global.css shows exactly one, decided
  before first paint by the bootstrap script in Layout.astro. Visitors without a
  stored city see the picker, everyone else goes straight to their city's page.
*/
}
<Layout>
  <CityPicker />
  <CityHome />
</Layout>
