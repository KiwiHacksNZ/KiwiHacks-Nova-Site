---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import {
  CITIES,
  CITY_COOKIE,
  CITY_STORAGE_KEY,
  DEFAULT_CITY_SLUG,
} from "../data/cities";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "KiwiHacks Nova",
  description = "Nova: New Zealand's free 24-hour hackathon for high school students, by KiwiHacks.",
  ogImage = "/nova-logo.png",
} = Astro.props;

const CITY_SLUGS = CITIES.map((c) => c.slug);

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://nova.kiwihacks.org.nz",
);
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/nova-logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL)} />
    {
      /*
      Runs before first paint, and decides which city the page shows:

        1. a city the visitor picked, from localStorage — shows no banner
        2. the city the edge middleware guessed from their IP, from a cookie
        3. the default city

      The result goes on <html> as `data-city`. Cases 2 and 3 also set
      `data-city-default`, to the reason, which is what the hint banner keys
      off — so the banner shows unless the city was explicitly chosen.
    */
    }
    <script
      is:inline
      define:vars={{
        storageKey: CITY_STORAGE_KEY,
        cookieName: CITY_COOKIE,
        slugs: CITY_SLUGS,
        defaultSlug: DEFAULT_CITY_SLUG,
      }}
    >
      (function () {
        var root = document.documentElement;

        var chosen = null;
        try {
          chosen = localStorage.getItem(storageKey);
        } catch (e) {
          // Storage blocked — treat as "no choice yet".
        }
        if (chosen && slugs.indexOf(chosen) !== -1) {
          root.dataset.city = chosen;
          return;
        }

        var match = document.cookie.match(
          "(?:^|; *)" + cookieName + "=([^;]*)",
        );
        var detected = match ? decodeURIComponent(match[1]) : null;
        if (detected && slugs.indexOf(detected) !== -1) {
          root.dataset.city = detected;
          root.dataset.cityDefault = "detected";
        } else {
          root.dataset.city = defaultSlug;
          root.dataset.cityDefault = "fallback";
        }
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col">
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
