---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import { CITIES, CITY_STORAGE_KEY } from "../data/cities";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "KiwiHacks Nova",
  description = "Nova: New Zealand's free 24-hour hackathon for high school students, by KiwiHacks.",
  ogImage = "/nova-logo.png",
} = Astro.props;

const CITY_SLUGS = CITIES.map((c) => c.slug);

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://nova.kiwihacks.org.nz",
);
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/nova-logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL)} />
    {
      /*
      Runs before first paint so the city gate never flashes: stamps <html>
      with the restored city, or marks the page as needing a choice.
    */
    }
    <script
      is:inline
      define:vars={{ storageKey: CITY_STORAGE_KEY, slugs: CITY_SLUGS }}
    >
      (function () {
        var slug = null;
        try {
          slug = localStorage.getItem(storageKey);
        } catch (e) {
          // Storage blocked — treat as "no choice yet".
        }
        if (slug && slugs.indexOf(slug) !== -1) {
          document.documentElement.dataset.city = slug;
        } else {
          document.documentElement.dataset.cityPick = "";
        }
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col">
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
