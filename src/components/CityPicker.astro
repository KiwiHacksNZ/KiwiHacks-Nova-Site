---
import { Image } from "astro:assets";
import { CITIES } from "../data/cities";
import heroLogo from "../assets/images/Kiwihacks_-_Nova_Logo_2.png";
---

{
  /*
  The gate shown on "/" until a city is chosen. Hidden by default; the CSS in
  global.css reveals it when <html> carries `data-city-pick`.

  The gated element carries no layout of its own, because the reveal rule sets
  `display: block` on it. All the flex layout lives on the inner wrapper.
*/
}
<div data-city-gate>
  <div
    class="mx-auto flex max-w-3xl flex-col items-center px-5 pt-12 pb-24 text-center sm:pt-20"
  >
    <Image
      src={heroLogo}
      alt="KiwiHacks presents Nova"
      width={448}
      height={448}
      fetchpriority="high"
      loading="eager"
      class="h-56 w-auto select-none sm:h-72"
    />

    <h1 class="mt-6 text-3xl font-semibold text-white sm:text-4xl">
      Pick your city
    </h1>

    <p class="mt-3 max-w-xl text-lg text-white/80 sm:text-xl">
      Nova runs across three cities. Choose the one you'd come to and we'll show
      you its dates. You can change it any time from the menu.
    </p>

    <div class="mt-10 flex w-full flex-col gap-4">
      {
        CITIES.map((city) => (
          <button
            type="button"
            data-city-gate-select={city.slug}
            class="group flex w-full items-center justify-between gap-4 rounded-2xl bg-[#4f46e5] px-6 py-5 text-left shadow-lg transition-colors hover:bg-[#5b52ee] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
          >
            <span class="text-xl font-semibold text-white sm:text-2xl">
              {city.name}
            </span>
            <span class="flex items-center gap-3">
              <span class="text-sm text-white/75 sm:text-base">
                {city.date}
              </span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                class="h-5 w-5 shrink-0 text-white transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              >
                <path
                  d="M9 6l6 6-6 6"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { cityBySlug } from "../data/cities";
  import { selectCity } from "../state";

  document
    .querySelectorAll<HTMLButtonElement>("[data-city-gate-select]")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const picked = cityBySlug(btn.dataset.cityGateSelect ?? "");
        if (picked) {
          selectCity(picked);
          window.scrollTo({ top: 0 });
        }
      });
    });
</script>
